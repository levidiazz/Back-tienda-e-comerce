# Copia este archivo a .env si deseas personalizar puertos, credenciales o CORS.
# Si no creas .env, compose.yaml usará estos valores por defecto.

DB_NAME=ecommerce_bd
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

BACKEND_PORT=8080
DB_POOL_MAX=10
DB_POOL_MIN=2

# Clave AES-256 en Base64 (32 bytes). Puedes generar una nueva con: openssl rand -base64 32
CIFRADO_CLAVE=dnz8VsLjUv/E45JcEbflYg3hZKa0e0CXC2+R5LmoCso=

# Origen permitido para CORS (tu frontend)
CORS_ORIGEN=http://localhost:4200

TZ=America/Mexico_City
